<UserControl
    x:Class="NpuChat.VoiceOrb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
    <Viewbox Stretch="Uniform">
        <Grid Width="144" Height="144" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="FloatMotion" />
            </Grid.RenderTransform>
            <Ellipse>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="Halo" Color="#BC43E3DC" Offset="0.16" />
                        <GradientStop x:Name="HaloEdge" Color="#5043E3DC" Offset="0.49" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Grid Width="91" Height="91" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="PulseMotion" />
                </Grid.RenderTransform>
                <Ellipse Stroke="#8FD4F9FF" StrokeThickness="1.15">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.32,0.24">
                            <GradientStop Color="#F5FFFF" Offset="0" />
                            <GradientStop x:Name="Core" Color="#43E3DC" Offset="0.36" />
                            <GradientStop x:Name="Rim" Color="#3866C6" Offset="0.79" />
                            <GradientStop Color="#10182D" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.90,0.93">
                            <GradientStop x:Name="EmberRim" Color="#DFFFB473" Offset="0" />
                            <GradientStop Color="#00FF8B52" Offset="0.60" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
